<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Al Ihsan unified donation dashboard: a standalone page (no website layout) served at /alihsan/dashboard -->
    <template id="dashboard_page" name="Al Ihsan Dashboard">
        &lt;!DOCTYPE html&gt;
        <html lang="en" dir="ltr">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <meta name="robots" content="noindex"/>
            <title>Dashboard — Al Ihsan</title>
            <link rel="icon" href="/alihsanwebsite_theme/static/src/img/logo.svg"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link rel="stylesheet" t-attf-href="/alihsanwebsite_theme/static/src/dashboard/fonts.css?v=#{asset_version}"/>
            <link rel="stylesheet" t-attf-href="/alihsanwebsite_theme/static/src/dashboard/dashboard.css?v=#{asset_version}"/>
            <script>try{var t=localStorage.getItem("db-theme");if(t==='"dark"'||(t?false:matchMedia("(prefers-color-scheme: dark)").matches))document.documentElement.dataset.theme="dark"}catch(e){}</script>
        </head>
        <body>
        <div class="db" id="db">

        <aside class="db-side" id="db-side" aria-label="Dashboard navigation">
          <a class="db-brand" href="#overview" aria-label="Al Ihsan dashboard home">
            <img src="/alihsanwebsite_theme/static/src/img/logo-white.svg" alt="Al Ihsan Charity Association"/>
            <span><b data-ar="لوحة التبرعات الموحدة">Unified Donation CMS</b><small id="db-mode" data-ar="بيانات أودو المباشرة">Live Odoo data</small></span>
          </a>
          <nav class="db-nav" id="db-nav"></nav>
          <div class="db-side-foot">
            <a class="db-site" href="/odoo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg><span data-ar="العودة إلى أودو">Back to Odoo</span></a>
            <a class="db-site" href="/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg><span data-ar="عرض الموقع">View website</span></a>
          </div>
        </aside>
        <div class="db-scrim" id="db-scrim" hidden=""></div>

        <div class="db-main">
          <header class="db-top">
            <button class="db-ico db-burger" id="db-burger" type="button" aria-label="Open menu" aria-controls="db-side" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
            <form class="db-search" id="db-search" role="search">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <input id="db-q" type="search" placeholder="Search campaigns, donations, donors, kiosks…" data-ar-ph="ابحث في الحملات والتبرعات والمتبرعين والأكشاك…" aria-label="Search"/>
              <kbd class="db-kbd" id="db-kbd">Ctrl K</kbd>
            </form>
            <div class="db-top-r">
              <button class="db-ico db-sbtn" id="db-sbtn" type="button" aria-label="Search and commands"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
              <button class="db-ico theme-ico" id="db-theme" type="button" aria-label="Toggle dark mode" aria-pressed="false"><svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
              <div class="db-lang" role="group" aria-label="Language"><button type="button" data-lang="en" class="on">EN</button><button type="button" data-lang="ar">AR</button></div>
              <div class="db-pop-wrap">
                <button class="db-ico" id="db-bell" type="button" aria-label="Notifications" aria-haspopup="true" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg><i class="db-dot" id="db-bell-dot"></i></button>
                <div class="db-pop" id="db-notes" hidden=""></div>
              </div>
              <div class="db-pop-wrap">
                <button class="db-user" id="db-user" type="button" aria-haspopup="true" aria-expanded="false"><span class="db-av" t-esc="(user_name or 'A')[:1]"/><span class="db-uname" t-esc="user_name"/><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
                <div class="db-pop db-menu" id="db-umenu" hidden="">
                  <a href="#settings" data-ar="الإعدادات">Settings</a>
                  <a href="#users" data-ar="المستخدمون والصلاحيات">Users &amp; Roles</a>
                  <a href="/odoo" data-ar="العودة إلى أودو">Back to Odoo</a>
                  <a href="/" target="_blank" rel="noopener" data-ar="الموقع العام">Public website</a>
                  <a href="/web/session/logout" id="db-logout" data-ar="تسجيل الخروج">Sign out</a>
                </div>
              </div>
            </div>
          </header>

          <main class="db-view" id="db-view" tabindex="-1"></main>
        </div>
        </div>

        <!-- shared modal + toast -->
        <dialog class="db-modal" id="db-modal" aria-labelledby="db-modal-t"><form method="dialog" class="db-modal-in" id="db-modal-form" novalidate=""></form></dialog>
        <div class="db-toasts" id="db-toasts" aria-live="polite" popover="manual"></div>
        <dialog class="cmdk" id="db-cmdk" aria-label="Command palette"><div class="cmdk-in"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="db-cmdk-q" type="text" autocomplete="off" placeholder="Jump to a page, campaign, kiosk or action…" aria-label="Command" aria-controls="db-cmdk-l"/><kbd class="db-k">Esc</kbd></div><div class="cmdk-l" id="db-cmdk-l" role="listbox"></div><div class="cmdk-f"><span><kbd>↑</kbd> <kbd>↓</kbd> <span data-ar="للتنقل">to move</span></span><span><kbd>Enter</kbd> <span data-ar="للفتح">to open</span></span></div></dialog>

        <!-- data: null = sample data (default), JSON = live Odoo data (/alihsan/dashboard?live=1) -->
        <script type="application/json" id="db-data" t-out="dashboard_json"/>
        <script t-attf-src="/alihsanwebsite_theme/static/src/dashboard/dashboard.js?v=#{asset_version}"></script>
        </body>
        </html>
    </template>
</odoo>
