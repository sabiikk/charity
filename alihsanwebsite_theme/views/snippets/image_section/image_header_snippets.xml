<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="image_header_section" name="Image Header Section">
        <section class="gl-sec s_gl_header pt16 pb0">
            <div class="container">
                <div class="mc-crumb" role="navigation" aria-label="Breadcrumb">
                    <ol>
                        <li><a href="/">Home</a></li>
                        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg><a href="/media-center">Media Center</a></li>
                        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg><span aria-current="page">Images</span></li>
                    </ol>
                </div>
