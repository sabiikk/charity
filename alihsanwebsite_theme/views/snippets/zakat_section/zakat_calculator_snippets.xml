<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Zakat calculator. Settings live on the section:
        data-base24  = indicative 24k gold price (AED / gram); other karats derive from it
        data-nisab-g = nisab in grams of gold
        data-pay-url = where "Pay My Zakat" goes; ?amount=<zakat> is appended
    -->
    <template id="zakat_calculator_section" name="Zakat Calculator Section">
        <section class="zk-sec s_zk_calculator pt0 pb40" data-base24="595.45" data-nisab-g="85" data-currency="AED" data-pay-url="/donation/pay">
            <div class="container">
                <div class="zk-grid">
                    <div class="zk-col">
                        <div class="zk-card">
                            <div class="zk-ch">
                                <span class="zk-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.500 9.500c0-1 1-1.500 2.500-1.500s2.500.7 2.500 1.800c0 2.200-5 1.200-5 3.400 0 1.100 1 1.800 2.500 1.800s2.500-.5 2.500-1.500"/></svg></span>
                                <div>
                                    <h2>Gold price</h2>
                                    <p>The price of 1 gram of gold for the following:</p>
                                </div>
                            </div>
                            <div class="zk-row">
                                <div class="zk-karats" role="radiogroup" aria-label="Gold purity">
                                    <label class="zk-k"><input type="radio" name="zk-karat" value="18"/><span>18k</span></label>
                                    <label class="zk-k"><input type="radio" name="zk-karat" value="21"/><span>21k</span></label>
                                    <label class="zk-k"><input type="radio" name="zk-karat" value="22" checked="checked"/><span>22k</span></label>
                                    <label class="zk-k"><input type="radio" name="zk-karat" value="24"/><span>24k</span></label>
                                </div>
                                <label class="zk-field zk-price"><span>AED / gram</span><input class="zk-in-price" type="number" min="0" step="0.01" inputmode="decimal" value="545.83" aria-label="Gold price per gram"/></label>
                            </div>
                            <p class="zk-note">Prices are indicative — adjust the price to today’s market rate.</p>
                        </div>
                        <div class="zk-card">
                            <div class="zk-ch">
                                <span class="zk-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.500 9.500c0-1 1-1.500 2.500-1.500s2.500.7 2.500 1.800c0 2.200-5 1.200-5 3.400 0 1.100 1 1.800 2.500 1.800s2.500-.5 2.500-1.500"/></svg></span>
                                <div>
                                    <h2>Your gold</h2>
                                    <p>Weight in grams</p>
                                </div>
                                <label class="zk-field zk-inl"><span>Gram</span><input class="zk-in-gold" type="number" min="0" max="1000000" step="0.1" value="5" inputmode="decimal" aria-label="Gold in grams"/></label>
                            </div>
                            <input class="zk-range zk-in-gold-r" type="range" min="0" max="10000" step="1" value="5" aria-label="Gold in grams slider"/>
                            <div class="zk-scale"><span>Gram 0</span><span>Gram 10,000</span></div>
                        </div>
                        <div class="zk-card">
                            <div class="zk-ch">
                                <span class="zk-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7a2 2 0 0 1 2-2h12v4"/><path d="M4 7v10a2 2 0 0 0 2 2h14V9H6a2 2 0 0 1-2-2z"/><circle cx="16.500" cy="14" r="1.200"/></svg></span>
                                <div>
                                    <h2>Your wealth</h2>
                                    <p>Cash, savings and investments (AED)</p>
                                </div>
                                <label class="zk-field zk-inl"><span>AED</span><input class="zk-in-wealth" type="number" min="0" step="1" value="10" inputmode="decimal" aria-label="Wealth in AED"/></label>
                            </div>
                            <input class="zk-range zk-in-wealth-r" type="range" min="0" max="1000000" step="100" value="10" aria-label="Wealth slider"/>
                            <div class="zk-scale"><span>AED 0</span><span>AED 1,000,000</span></div>
                        </div>
                    </div>
                    <aside class="zk-side">
                        <div class="zk-result">
                            <span class="zk-badge">Zakat amount</span>
                            <div class="zk-total"><small class="zk-cur">AED</small><b class="zk-out">0.00</b></div>
                            <p class="zk-rate">2.5% of your total gold and wealth</p>
                            <dl class="zk-break">
                                <div><dt>Gold value</dt><dd class="zk-b-gold">AED 0.00</dd></div>
                                <div><dt>Wealth</dt><dd class="zk-b-wealth">AED 0.00</dd></div>
                                <div><dt>Total zakatable</dt><dd class="zk-b-total">AED 0.00</dd></div>
                            </dl>
                            <div class="zk-nisab">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.500 3.200 7.800 8 9 4.800-1.200 8-4.500 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg>
                                <span class="zk-nisab-t">Zakat is due once your gold and wealth reach the nisab.</span>
                            </div>
                            <a class="zk-pay" href="/donation/pay">
                                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-8-5-8-11a4.500 4.500 0 0 1 8-2.800A4.500 4.500 0 0 1 20 10c0 6-8 11-8 11z"/></svg>
                                <span>Pay My Zakat</span>
                            </a>
                            <p class="zk-secure">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                                <span>Secure, encrypted payment</span>
                            </p>
                        </div>
                        <p class="zk-disc">This calculator is a guide only. For special cases, please consult a qualified scholar.</p>
                    </aside>
                </div>
            </div>
        </section>
    </template>
</odoo>
