<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- data-pay-url on the section: "Donate now" goes there with ?amount=<amount> (Odoo /donation/pay). -->
    <template id="direct_donation_direct_section" name="Direct Donation Form Section">
        <section class="dn-sec s_direct_donation_direct pt0 pb48" data-dn-panel="direct" data-pay-url="/donation/pay">
            <div class="container">
                <div class="dn-panel" data-panel="direct"><form class="dw dn-form" novalidate=""><div class="dw-card">
<ol class="dw-prog" aria-label="Steps"><li class="cur" data-s="1"><span class="dw-bar"/><span class="dw-dot">1</span><span class="dw-lab">Project &amp; amount</span></li><li data-s="2"><span class="dw-bar"/><span class="dw-dot">2</span><span class="dw-lab">Details</span></li></ol>
<div class="dw-pane on" data-step="1"><h3 class="dw-h">Select the project you want to donate for</h3><div class="dw-projs"><label class="dw-proj"><input type="radio" name="project" value="General donation · where need is greatest" checked="checked"/><span class="dw-pimg"><img src="/alihsanwebsite_theme/static/src/img/community.jpg" alt="" loading="lazy"/></span><span class="dw-pname">General donation · where need is greatest</span></label><label class="dw-proj"><input type="radio" name="project" value="Food Parcels"/><span class="dw-pimg"><img src="/alihsanwebsite_theme/static/src/img/food.jpg" alt="" loading="lazy"/></span><span class="dw-pname">Food Parcels</span></label><label class="dw-proj"><input type="radio" name="project" value="Al Safia Hospital"/><span class="dw-pimg"><img src="/alihsanwebsite_theme/static/src/img/hospital.jpg" alt="" loading="lazy"/></span><span class="dw-pname">Al Safia Hospital</span></label><label class="dw-proj"><input type="radio" name="project" value="Gaza Relief"/><span class="dw-pimg"><img src="/alihsanwebsite_theme/static/src/img/gaza.jpg" alt="" loading="lazy"/></span><span class="dw-pname">Gaza Relief</span></label><label class="dw-proj"><input type="radio" name="project" value="Clean Water"/><span class="dw-pimg"><img src="/alihsanwebsite_theme/static/src/img/water.jpg" alt="" loading="lazy"/></span><span class="dw-pname">Clean Water</span></label><label class="dw-proj"><input type="radio" name="project" value="Quran Centres"/><span class="dw-pimg"><img src="/alihsanwebsite_theme/static/src/img/quran.jpg" alt="" loading="lazy"/></span><span class="dw-pname">Quran Centres</span></label><label class="dw-proj"><input type="radio" name="project" value="Medical Care"/><span class="dw-pimg"><img src="/alihsanwebsite_theme/static/src/img/care.jpg" alt="" loading="lazy"/></span><span class="dw-pname">Medical Care</span></label><label class="dw-proj"><input type="radio" name="project" value="Orphan Sponsorship"/><span class="dw-pimg"><img src="/alihsanwebsite_theme/static/src/img/community.jpg" alt="" loading="lazy"/></span><span class="dw-pname">Orphan Sponsorship</span></label><label class="dw-proj"><input type="radio" name="project" value="Charitable Endowment"/><span class="dw-pimg"><img src="/alihsanwebsite_theme/static/src/img/endowment.jpg" alt="" loading="lazy"/></span><span class="dw-pname">Charitable Endowment</span></label></div><div class="dw-amtblock"><h3 class="dw-h dw-h2">How much would you like to give?</h3><div class="dw-chips"><button type="button" class="dw-chip" data-v="50"><b>50</b><small>AED</small></button><button type="button" class="dw-chip on" data-v="100"><b>100</b><small>AED</small></button><button type="button" class="dw-chip" data-v="250"><b>250</b><small>AED</small></button><button type="button" class="dw-chip" data-v="500"><b>500</b><small>AED</small></button><button type="button" class="dw-chip" data-v="1000"><b>1,000</b><small>AED</small></button><button type="button" class="dw-chip" data-v="2500"><b>2,500</b><small>AED</small></button></div><div class="dw-other"><div class="dw-oproj"><span class="dw-oimg"><img src="/alihsanwebsite_theme/static/src/img/community.jpg" alt="" class="dw-oimg-img"/></span><span class="dw-oname"><small>For</small><b class="dw-oname-v">—</b></span></div><label class="dw-amt"><small class="dw-amt-k">Your donation</small><span class="dw-amt-v"><input type="text" inputmode="numeric" autocomplete="off" value="100" aria-label="Amount in AED" class="dn-amount"/><b>AED</b></span></label><span class="dw-ospace" aria-hidden="true"/></div><div class="dw-range"><input type="range" min="10" max="50000" step="10" value="100" aria-label="Donation amount (AED)" class="dn-range"/><div class="dw-ticks" aria-hidden="true"><span>10</span><span>10K</span><span>20K</span><span>30K</span><span>40K</span><span>50K</span></div></div></div></div>
<div class="dw-pane" data-step="2"><h3 class="dw-h">Your details</h3><div class="dw-mode" role="tablist" aria-label="How would you like to continue?"><button type="button" role="tab" class="on" aria-selected="true" data-mode="guest"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Continue as a guest</span></button><button type="button" role="tab" aria-selected="false" data-mode="login"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><span>Login</span></button></div><div class="dw-grid dw-guest-pane" role="tabpanel"><label class="dw-f"><span>Full name</span><input name="fullname" type="text" required="" autocomplete="off"/></label><label class="dw-f"><span>Mobile number</span><input name="mobile" type="tel" required="" inputmode="tel" autocomplete="off"/></label></div><div class="dw-loginpane dw-login-pane" role="tabpanel" hidden=""><div class="dw-otprow"><label class="dw-f"><span>Mobile number</span><input name="lmobile" type="tel" inputmode="tel" maxlength="13" autocomplete="tel" placeholder="05X XXX XXXX"/></label><button type="button" class="dw-otpbtn dw-otp"><span class="dw-otp-t">Get OTP</span></button></div><label class="dw-f dw-otpf" hidden=""><span>Enter OTP</span><input name="otp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="• • • •"/></label><p class="dw-otpnote" hidden=""/></div><label class="dw-terms"><input type="checkbox" class="dn-terms-in"/><i/><span><span>I agree to the</span> <a href="https://alihsan.ae/ar" target="_blank" rel="noopener">Terms &amp; Conditions</a></span></label></div>

<p class="dn-err dw-msg" role="alert" hidden=""/><p class="dn-ok dw-msg ok" role="status" hidden=""/>
<div class="dw-nav"><div class="dw-mini" aria-live="polite"><small class="mini-proj">—</small><b><span class="mini-amt">100</span> <span>AED</span></b></div><button type="button" class="dw-back" hidden=""><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg><span>Back</span></button><button type="button" class="dw-next"><span class="dw-next-t">Continue</span><i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></i></button></div>
</div><aside class="dw-ticket" aria-label="Your donation"><div class="dw-timg"><img src="/alihsanwebsite_theme/static/src/img/community.jpg" alt="" class="tk-img"/></div><div class="dw-tbody"><span class="dw-tkick">YOUR DONATION</span><h4 class="tk-name">—</h4></div><div class="dw-tear"/><div class="dw-tfoot"><div><span>Total</span><b class="tk-freq">One-time</b></div><div class="dw-tamt"><strong class="tk-amt">100</strong><small>AED</small></div></div></aside></form></div>
            </div>
        </section>
    </template>
</odoo>
