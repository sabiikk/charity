<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Registration form + side panel + the "Volunteers login" dialog.
         There is no back end yet: the form is checked in the browser and then shows
         the thank-you card; nothing is sent (same as the static Volunteer.html). -->
    <template id="volunteer_register_section" name="Volunteer Register Section">
        <section class="ar-sec vl-page s_vl_register pt0 pb64">
            <div class="container">
                <div class="vl-wrap"><div><form class="vl-card ar-fade" id="vl-form" novalidate="novalidate">
                <div class="vl-top"><span class="vl-hi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><circle cx="17" cy="9" r="2.6"/><path d="M16 14.2c3 .2 5.5 2.2 5.5 5.3"/></svg></span><div><h2>Register</h2><p>Fill in your details to join our volunteer team.</p></div></div>
                <fieldset class="vl-sec"><legend>Registration</legend><div class="vl-grid two">
                <div class="vl-f"><label for="vl-type"><span>Registration type</span> <b aria-hidden="true">*</b></label><select id="vl-type" name="type" required="required" aria-describedby="vl-type-e"><option value="person">Person</option><option value="family">Family</option></select><span class="vl-err" id="vl-type-e" aria-live="polite"></span></div>
                <div class="vl-f"><label for="vl-group"><span>Select the volunteer group</span> <b aria-hidden="true">*</b></label><select id="vl-group" name="group" required="required" aria-describedby="vl-group-e"><option value="">Select the volunteer group</option><option value="Ataa Hamdan Volunteer">Ataa Hamdan Volunteer</option><option value="Ataa Volunteer Team">Ataa Volunteer Team</option><option value="Azwaa Volunteer Team">Azwaa Volunteer Team</option><option value="Dubai Scout Mission">Dubai Scout Mission</option><option value="Fakher Almujtamae Volunteer">Fakher Almujtamae Volunteer</option><option value="Kuluna Hadirin">Kuluna Hadirin</option><option value="Kunooz Alwatan">Kunooz Alwatan</option><option value="Pupilar">Pupilar</option><option value="Ras Al Khaimah Volunteer Team">Ras Al Khaimah Volunteer Team</option><option value="Sanad Volunteer Team">Sanad Volunteer Team</option><option value="Smile volunteer">Smile volunteer</option><option value="Thank You For Your Giving">Thank You For Your Giving</option><option value="Tiba UAE Varieties">Tiba UAE Varieties</option><option value="UAE Ambassadors Association">UAE Ambassadors Association</option><option value="UAE Creators">UAE Creators</option><option value="Zayed Volunteer Knights">Zayed Volunteer Knights</option><option value="صقور الامارات التطوعي">صقور الامارات التطوعي</option><option value="نبض الامارات التطوعي">نبض الامارات التطوعي</option></select><span class="vl-err" id="vl-group-e" aria-live="polite"></span></div>
                </div></fieldset>
                <fieldset class="vl-sec"><legend>Name</legend><div class="vl-grid">
                <div class="vl-f"><label for="vl-first"><span>First Name</span> <b aria-hidden="true">*</b></label><input id="vl-first" name="first" type="text" required="required" autocomplete="given-name" aria-describedby="vl-first-e"/><span class="vl-err" id="vl-first-e" aria-live="polite"></span></div>
                <div class="vl-f"><label for="vl-second"><span>Second Name</span> <b aria-hidden="true">*</b></label><input id="vl-second" name="second" type="text" required="required" autocomplete="additional-name" aria-describedby="vl-second-e"/><span class="vl-err" id="vl-second-e" aria-live="polite"></span></div>
                <div class="vl-f"><label for="vl-third"><span>Third Name</span> <b aria-hidden="true">*</b></label><input id="vl-third" name="third" type="text" required="required" autocomplete="family-name" aria-describedby="vl-third-e"/><span class="vl-err" id="vl-third-e" aria-live="polite"></span></div>
                </div></fieldset>
                <fieldset class="vl-sec"><legend>Personal details</legend><div class="vl-grid">
                <div class="vl-f"><label for="vl-dob"><span>Date of Birth</span> <b aria-hidden="true">*</b></label><small class="vl-note">Participation is allowed at 5 years and above</small><input id="vl-dob" name="dob" type="date" required="required" autocomplete="bday" aria-describedby="vl-dob-e"/><span class="vl-err" id="vl-dob-e" aria-live="polite"></span></div>
                <div class="vl-f"><label for="vl-gender"><span>Gender</span> <b aria-hidden="true">*</b></label><select id="vl-gender" name="gender" required="required" aria-describedby="vl-gender-e"><option value="male">Male</option><option value="female">Female</option></select><span class="vl-err" id="vl-gender-e" aria-live="polite"></span></div>
                <div class="vl-f"><label for="vl-nat"><span>Nationality</span> <b aria-hidden="true">*</b></label><select id="vl-nat" name="nat" required="required" aria-describedby="vl-nat-e"><option value="">Select Nationality</option></select><span class="vl-err" id="vl-nat-e" aria-live="polite"></span></div>
                <div class="vl-f"><label for="vl-city"><span>City</span> <b aria-hidden="true">*</b></label><select id="vl-city" name="city" required="required" aria-describedby="vl-city-e"><option value="">Select City</option><option value="Abu Dhabi">Abu Dhabi</option><option value="Al Ain">Al Ain</option><option value="Dubai">Dubai</option><option value="Sharjah">Sharjah</option><option value="Ajman">Ajman</option><option value="Fujairah">Fujairah</option><option value="Ras Al Khaimah">Ras Al Khaimah</option><option value="Umm Al Quwain">Umm Al Quwain</option><option value="Al Dafrah">Al Dafrah</option></select><span class="vl-err" id="vl-city-e" aria-live="polite"></span></div>
                <div class="vl-f span2"><label for="vl-news"><span>Would you like us to inform you of our charitable initiatives?</span></label><select id="vl-news" name="news" aria-describedby="vl-news-e"><option value="yes">Yes</option><option value="no">No</option></select><span class="vl-err" id="vl-news-e" aria-live="polite"></span></div>
                </div></fieldset>
                <fieldset class="vl-sec"><legend>Login information</legend><div class="vl-grid two">
                <div class="vl-f"><label for="vl-email"><span>E-mail</span> <b aria-hidden="true">*</b></label><input id="vl-email" name="email" type="email" required="required" autocomplete="email" aria-describedby="vl-email-e" inputmode="email" placeholder="name@example.com"/><span class="vl-err" id="vl-email-e" aria-live="polite"></span></div>
                <div class="vl-f"><span class="vl-lab" id="vl-phone-l"><span>Phone number</span> <b aria-hidden="true">*</b></span><div class="vl-phone"><select aria-label="Network code" id="vl-net" name="net" required="required" aria-describedby="vl-net-e"><option value="">Network</option><option value="97150">97150</option><option value="97152">97152</option><option value="97154">97154</option><option value="97155">97155</option><option value="97156">97156</option><option value="97158">97158</option></select><input id="vl-phone" name="phone" type="tel" inputmode="numeric" required="required" autocomplete="tel-local" maxlength="7" placeholder="1234567" aria-labelledby="vl-phone-l" aria-describedby="vl-phone-e"/></div><span class="vl-err" id="vl-net-e" aria-live="polite"></span><span class="vl-err" id="vl-phone-e" aria-live="polite"></span></div>
                <div class="vl-f"><label for="vl-pw"><span>Password</span> <b aria-hidden="true">*</b></label><div class="vl-pass"><input id="vl-pw" name="pw" type="password" required="required" autocomplete="new-password" aria-describedby="vl-pw-e" minlength="8"/><button type="button" class="vl-eye" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="o"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></g><g class="c"><path d="M3 3l18 18"/><path d="M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6C3.8 8.4 2 12 2 12s3.5 7 10 7a9.6 9.6 0 0 0 5.4-1.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></g></svg></button></div><span class="vl-err" id="vl-pw-e" aria-live="polite"></span></div>
                <div class="vl-f"><label for="vl-pw2"><span>Confirm Password</span> <b aria-hidden="true">*</b></label><div class="vl-pass"><input id="vl-pw2" name="pw2" type="password" required="required" autocomplete="new-password" aria-describedby="vl-pw2-e"/><button type="button" class="vl-eye" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="o"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></g><g class="c"><path d="M3 3l18 18"/><path d="M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6C3.8 8.4 2 12 2 12s3.5 7 10 7a9.6 9.6 0 0 0 5.4-1.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></g></svg></button></div><span class="vl-err" id="vl-pw2-e" aria-live="polite"></span></div>
                </div></fieldset>
                <div class="vl-terms"><input type="checkbox" id="vl-terms" name="terms" required="required" aria-describedby="vl-terms-e"/><label for="vl-terms"><span>I agree with all</span> <a href="/faq" target="_blank" rel="noopener">Terms &amp; Conditions</a></label><span class="vl-err" id="vl-terms-e" aria-live="polite"></span></div>
                <button class="vl-submit" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg><span>Register</span></button>
                <p class="vl-req"><b>*</b> <span>Required fields</span></p>
                </form>
                <section class="vl-card vl-done" id="vl-done" hidden="hidden" aria-live="polite"><div class="vl-ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div><h2><span>Thank you</span> <span id="vl-done-name"></span>!</h2><p>Your volunteer registration has been received. Our team will contact you soon by e-mail or phone.</p><button type="button" id="vl-again">Register another volunteer</button></section></div><aside class="vl-side">
                <div class="vl-have ar-fade"><h3>Already a volunteer?</h3><p>Log in to follow your shifts and volunteering hours.</p><button type="button" class="vl-havebtn" data-vl-login=""><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5M15 12H3"/></svg><span>Volunteers login</span></button></div>
                <div class="vl-why ar-fade"><h3>Why volunteer with us?</h3><ul>
                <li><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10z"/></svg></span><p>Make a real difference for families in need across the UAE.</p></li>
                <li><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg></span><p>Join campaigns such as Ramadan Aman, Udhiyah and winter drives.</p></li>
                <li><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15l-3.5 2 1-4-3-2.7 4-.3L12 6l1.5 4 4 .3-3 2.7 1 4z"/><circle cx="12" cy="12" r="10"/></svg></span><p>Receive a certificate and have your volunteering hours recorded.</p></li>
                <li><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><circle cx="17" cy="9" r="2.6"/><path d="M16 14.2c3 .2 5.5 2.2 5.5 5.3"/></svg></span><p>Open to individuals and families, from 5 years old.</p></li>
                </ul></div>
                <div class="vl-help ar-fade"><h3>Need help?</h3><span>Contact us and we will help you register.</span><br/><a href="tel:80016"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg><span>800 16</span></a></div>
                </aside></div>
                <dialog class="vl-dlg" id="vl-login" aria-labelledby="vl-login-t"><form class="vl-lform" id="vl-lform" method="dialog" novalidate="novalidate">
                <div class="vl-lhead"><span class="vl-hi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><circle cx="17" cy="9" r="2.6"/><path d="M16 14.2c3 .2 5.5 2.2 5.5 5.3"/></svg></span><h2 id="vl-login-t">Volunteers login</h2><button type="button" class="vl-x" id="vl-lclose" aria-label="Close">×</button></div>
                <div class="vl-f"><span class="vl-lab" id="vl-lphone-l"><span>Phone number</span> <b aria-hidden="true">*</b></span><div class="vl-phone"><select id="vl-lnet" name="network" required="required" aria-label="Network code" aria-describedby="vl-lnet-e"><option value="">Network</option><option value="97150">97150</option><option value="97152">97152</option><option value="97154">97154</option><option value="97155">97155</option><option value="97156">97156</option><option value="97158">97158</option></select><input id="vl-lphone" name="phone" type="tel" inputmode="numeric" required="required" autocomplete="tel-local" maxlength="7" placeholder="1234567" aria-labelledby="vl-lphone-l" aria-describedby="vl-lphone-e"/></div><span class="vl-err" id="vl-lnet-e" aria-live="polite"></span><span class="vl-err" id="vl-lphone-e" aria-live="polite"></span></div>
                <div class="vl-f"><label for="vl-lpw"><span>Password</span> <b aria-hidden="true">*</b></label><div class="vl-pass"><input id="vl-lpw" name="password" type="password" required="required" autocomplete="current-password" aria-describedby="vl-lpw-e"/><button type="button" class="vl-eye" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="o"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></g><g class="c"><path d="M3 3l18 18"/><path d="M10.6 5.1A10 10 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6C3.8 8.4 2 12 2 12s3.5 7 10 7a9.6 9.6 0 0 0 5.4-1.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></g></svg></button></div><span class="vl-err" id="vl-lpw-e" aria-live="polite"></span></div>
                <button class="vl-submit" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5M15 12H3"/></svg><span>Sign in</span></button>
                <div class="vl-lrow"><label class="vl-remember"><input type="checkbox" id="vl-lremember" name="remember"/><span>Remember me</span></label><button type="button" class="vl-forgot" id="vl-forgot">Forgot password?</button></div>
                <p class="vl-lmsg" id="vl-lmsg" hidden="hidden" aria-live="polite"></p>
                <p class="vl-lfoot"><span>Not registered yet?</span> <button type="button" class="vl-forgot" id="vl-toreg">Register now</button></p>
                </form></dialog>
            </div>
        </section>
    </template>
</odoo>
