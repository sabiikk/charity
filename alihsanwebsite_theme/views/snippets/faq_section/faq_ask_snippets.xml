<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Questions are posted to /alihsan/faq/ask and emailed to the website company's email -->
    <template id="faq_ask_section" name="FAQ Ask Section">
        <section class="fq-sec s_fq_ask pt56 pb40">
            <div class="container">
                <div class="fq-ask">
                    <div class="fq-ill">
                        <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="56" fill="#fdeedd"/><rect x="56" y="22" width="7" height="70" rx="3.500" fill="#fff" stroke="#00705a" stroke-width="2"/><rect x="50" y="78" width="19" height="14" fill="#00705a"/><path d="M56 30H30l-6 6 6 6h26z" fill="#c8960c"/><path d="M63 40h28l5 5-5 5H63z" fill="#a9afc8"/><circle cx="92" cy="90" r="12" fill="#fff" stroke="#00705a" stroke-width="2"/><text x="92" y="96" font-size="16" font-weight="700" text-anchor="middle" fill="#c8960c">?</text></svg>
                    </div>
                    <h2>Can’t find your way?</h2>
                    <p>Write your question in below box and let us know your query!</p>
                    <div class="fq-form">
                        <textarea class="fq-text" rows="4" maxlength="2000" placeholder="Write your question here..." aria-label="Your question"/>
                        <p class="fq-msg d-none"/>
                        <button type="button" class="fq-submit">Submit</button>
                    </div>
                    <div class="fq-contact">
                        <a href="tel:80016"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg><span>800 16</span></a>
                        <a href="/contactus"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>Email us</span></a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
