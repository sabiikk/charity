<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="home_hero_slide_view_kanban" model="ir.ui.view">
        <field name="name">alihsan.home.hero.slide.kanban</field>
        <field name="model">alihsan.home.hero.slide</field>
        <field name="arch" type="xml">
            <kanban class="o_ih_hero_kanban" default_order="sequence, id" quick_create="false">
                <field name="active"/>
                <field name="image_mobile"/>
                <field name="link_new_tab"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <templates>
                    <t t-name="card" class="p-0 overflow-hidden">
                        <div class="o_ih_slide_media position-relative">
                            <field name="image" widget="image" class="d-block" options="{'img_class': 'o_ih_slide_img'}"/>
                            <span class="o_ih_slide_pos badge rounded-pill position-absolute top-0 start-0 m-2">
                                <i class="fa fa-arrows me-1" title="Drag the card to reorder"/>Slide <field name="position"/>
                            </span>
                            <field name="state" widget="badge" class="position-absolute top-0 end-0 m-2"
                                   decoration-success="state == 'live'"
                                   decoration-info="state == 'scheduled'"
                                   decoration-warning="state == 'expired'"
                                   decoration-muted="state == 'hidden'"/>
                            <span t-if="record.image_mobile.raw_value" class="badge text-bg-dark position-absolute bottom-0 end-0 m-2">
                                <i class="fa fa-mobile me-1"/>Mobile image
                            </span>
                        </div>
                        <div class="p-3 d-flex flex-column gap-2">
                            <div class="d-flex align-items-start gap-2">
                                <field name="sequence" widget="handle" class="d-none"/>
                                <field name="name" class="fw-bold fs-5 flex-grow-1 text-truncate"/>
                                <div class="oe_kanban_action" title="Published on the website">
                                    <field name="active" widget="boolean_toggle"/>
                                </div>
                            </div>
                            <div class="small text-muted text-truncate" t-if="record.tagline.raw_value">
                                <i class="fa fa-quote-left me-1" title="Caption"/><field name="tagline"/>
                            </div>
                            <div class="small text-truncate">
                                <t t-if="record.link_url.raw_value">
                                    <i class="fa fa-link me-1 text-primary" title="Link"/><field name="link_url"/>
                                    <i t-if="record.link_new_tab.raw_value" class="fa fa-external-link ms-1 text-muted" title="Opens in a new tab"/>
                                </t>
                                <span t-else="" class="text-warning"><i class="fa fa-unlink me-1"/>No link set</span>
                            </div>
                            <div class="small text-muted" t-if="record.date_start.raw_value or record.date_end.raw_value">
                                <i class="fa fa-calendar me-1" title="Schedule"/>
                                <t t-if="record.date_start.raw_value">From <field name="date_start" widget="date"/></t>
                                <t t-if="record.date_end.raw_value"> until <field name="date_end" widget="date"/></t>
                            </div>
                            <field name="website_id" class="small text-muted" groups="website.group_multi_website"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="home_hero_slide_view_list" model="ir.ui.view">
        <field name="name">alihsan.home.hero.slide.list</field>
        <field name="model">alihsan.home.hero.slide</field>
        <field name="arch" type="xml">
            <list string="Home Hero Slides" default_order="sequence, id"
                  decoration-muted="state in ('hidden', 'expired')">
                <field name="sequence" widget="handle"/>
                <field name="position" string="#" width="40"/>
                <field name="image" widget="image" options="{'size': [96, 45]}" string="Preview" width="110"/>
                <field name="name"/>
                <field name="tagline" optional="hide"/>
                <field name="link_url" widget="url" optional="show"/>
                <field name="website_id" groups="website.group_multi_website" optional="show"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'live'"
                       decoration-info="state == 'scheduled'"
                       decoration-warning="state == 'expired'"
                       decoration-muted="state == 'hidden'"/>
                <field name="active" widget="boolean_toggle" string="Published"/>
            </list>
        </field>
    </record>

    <record id="home_hero_slide_view_form" model="ir.ui.view">
        <field name="name">alihsan.home.hero.slide.form</field>
        <field name="model">alihsan.home.hero.slide</field>
        <field name="arch" type="xml">
            <form string="Home Hero Slide" class="o_ih_hero_form">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,live,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Hidden" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Slide title"/>
                        <h1><field name="name" placeholder="e.g. Poor Housing Campaign"/></h1>
                        <div class="d-flex align-items-center gap-2">
                            <field name="active" widget="boolean_toggle" nolabel="1"/>
                            <span class="text-muted">Published on the website</span>
                        </div>
                    </div>

                    <div class="o_ih_section mt-4">
                        <h5 class="o_ih_step"><span>1</span>Banner images</h5>
                        <div class="row g-4">
                            <div class="col-lg-8">
                                <div class="fw-bold mb-1">Desktop <span class="text-muted fw-normal small">· recommended 1920 × 900 px, required</span></div>
                                <div class="o_ih_drop o_ih_drop_wide">
                                    <field name="image" widget="image" nolabel="1" options="{'img_class': 'o_ih_preview_img'}"/>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="fw-bold mb-1">Phone <span class="text-muted fw-normal small">· optional, portrait</span></div>
                                <div class="o_ih_drop o_ih_drop_tall">
                                    <field name="image_mobile" widget="image" nolabel="1" options="{'img_class': 'o_ih_preview_img'}"/>
                                </div>
                                <div class="text-muted small mt-1">Without it, phones show the desktop image.</div>
                            </div>
                        </div>
                    </div>

                    <div class="o_ih_section mt-4">
                        <h5 class="o_ih_step"><span>2</span>Text &amp; link</h5>
                        <group>
                            <group>
                                <field name="tagline" placeholder="CHARITABLE ENDOWMENT · GOOD THAT LIVES ON"/>
                                <field name="link_url" widget="url" placeholder="/projects-campaigns"/>
                                <field name="link_new_tab" invisible="not link_url"/>
                            </group>
                            <group>
                                <div class="text-muted small" colspan="2">
                                    The <b>caption</b> replaces the small line under the slider while this slide is shown.
                                    The <b>link</b> is used by the image, the <b>Donate now</b> button and the
                                    <b>Explore the campaign</b> link.
                                </div>
                            </group>
                        </group>
                    </div>

                    <div class="o_ih_section mt-4">
                        <h5 class="o_ih_step"><span>3</span>When &amp; where</h5>
                        <group>
                            <group>
                                <field name="date_start" placeholder="Right away"/>
                                <field name="date_end" placeholder="No end date"/>
                            </group>
                            <group>
                                <field name="website_id" groups="website.group_multi_website" options="{'no_create': True}" placeholder="All websites"/>
                                <field name="sequence" string="Order" help="Lower numbers show first. You can also drag the slides in the list."/>
                            </group>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="home_hero_slide_view_search" model="ir.ui.view">
        <field name="name">alihsan.home.hero.slide.search</field>
        <field name="model">alihsan.home.hero.slide</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="link_url"/>
                <filter name="live" string="Live" domain="[('active', '=', True), '|', ('date_start', '=', False), ('date_start', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59')), '|', ('date_end', '=', False), ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="published" string="Published" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Hidden" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_website" string="Website" context="{'group_by': 'website_id'}" groups="website.group_multi_website"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_home_hero_slide" model="ir.actions.act_window">
        <field name="name">Home Hero Slides</field>
        <field name="res_model">alihsan.home.hero.slide</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first home page banner</p>
            <p>Upload a banner image, set where it links to and drag the cards to change the order.
                Slider speed and autoplay are in Website &gt; Configuration &gt; Settings.</p>
        </field>
    </record>

    <menuitem id="menu_home_hero_slide"
              name="Home Hero Slides"
              parent="website.menu_content"
              action="action_home_hero_slide"
              groups="website.group_website_designer"
              sequence="90"/>
</odoo>
