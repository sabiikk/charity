<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="news_post_view_kanban" model="ir.ui.view">
        <field name="name">alihsan.news.post.kanban</field>
        <field name="model">alihsan.news.post</field>
        <field name="arch" type="xml">
            <kanban class="o_ih_hero_kanban" quick_create="false">
                <field name="active"/>
                <field name="featured"/>
                <templates>
                    <t t-name="card" class="p-0 overflow-hidden">
                        <div class="o_ih_slide_media position-relative">
                            <field name="image" widget="image" class="d-block" options="{'img_class': 'o_ih_slide_img'}"/>
                            <span t-if="record.tag.raw_value" class="badge rounded-pill text-bg-light position-absolute top-0 start-0 m-2">
                                <field name="tag"/>
                            </span>
                            <span t-if="record.featured.raw_value" class="badge text-bg-warning position-absolute top-0 end-0 m-2">
                                <i class="fa fa-star me-1"/>Featured
                            </span>
                        </div>
                        <div class="p-3 d-flex flex-column gap-2">
                            <div class="d-flex align-items-start gap-2">
                                <field name="name" class="fw-bold fs-5 flex-grow-1 text-truncate"/>
                                <div class="oe_kanban_action" title="Published on the website">
                                    <field name="active" widget="boolean_toggle"/>
                                </div>
                            </div>
                            <div class="small text-muted"><i class="fa fa-calendar me-1" title="Date"/><field name="date"/></div>
                            <div class="small text-muted text-truncate" t-if="record.summary.raw_value"><field name="summary"/></div>
                            <field name="website_id" class="small text-muted" groups="website.group_multi_website"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="news_post_view_list" model="ir.ui.view">
        <field name="name">alihsan.news.post.list</field>
        <field name="model">alihsan.news.post</field>
        <field name="arch" type="xml">
            <list string="News" decoration-muted="not active">
                <field name="image" widget="image" options="{'size': [72, 48]}" string="Preview" width="90"/>
                <field name="date"/>
                <field name="name"/>
                <field name="tag" optional="show"/>
                <field name="link_url" widget="url" optional="hide"/>
                <field name="website_id" groups="website.group_multi_website" optional="show"/>
                <field name="featured" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle" string="Published"/>
            </list>
        </field>
    </record>

    <record id="news_post_view_form" model="ir.ui.view">
        <field name="name">alihsan.news.post.form</field>
        <field name="model">alihsan.news.post</field>
        <field name="arch" type="xml">
            <form string="News">
                <sheet>
                    <widget name="web_ribbon" title="Hidden" bg_color="text-bg-secondary" invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image', 'size': [180, 120]}"/>
                    <div class="oe_title">
                        <label for="name" string="Title"/>
                        <h1><field name="name" placeholder="e.g. New partnership agreement signed"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="tag" placeholder="Campaigns"/>
                            <field name="featured"/>
                            <field name="active" string="Published"/>
                        </group>
                        <group>
                            <field name="website_url" widget="url" string="Story page" invisible="not id"/>
                            <field name="link_url" widget="url" placeholder="Empty: the story page"/>
                            <field name="link_new_tab" invisible="not link_url"/>
                            <field name="website_id" groups="website.group_multi_website" options="{'no_create': True}" placeholder="All websites"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Full Story" name="body">
                            <field name="body" placeholder="Text of the story page opened by 'Read more'..." options="{'height': 260}"/>
                        </page>
                        <page string="Summary" name="summary">
                            <field name="summary" placeholder="Short text shown under the title..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="news_post_view_search" model="ir.ui.view">
        <field name="name">alihsan.news.post.search</field>
        <field name="model">alihsan.news.post</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tag"/>
                <filter name="published" string="Published" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Hidden" domain="[('active', '=', False)]"/>
                <filter name="featured" string="Featured" domain="[('featured', '=', True)]"/>
                <group>
                    <filter name="group_tag" string="Tag" context="{'group_by': 'tag'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_news_post" model="ir.actions.act_window">
        <field name="name">News</field>
        <field name="res_model">alihsan.news.post</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first news story</p>
            <p>Stories appear in the "News List Section" of the Media Center, newest first.</p>
        </field>
    </record>

    <menuitem id="menu_news_post"
              name="News"
              parent="website.menu_content"
              action="action_news_post"
              groups="website.group_website_designer"
              sequence="91"/>
</odoo>
