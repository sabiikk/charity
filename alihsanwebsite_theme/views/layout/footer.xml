<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Al Ihsan footer (converted from footer.js / footer.css of "Al Ihsan web 7").
        - Replaces Odoo's footer#bottom but keeps id="bottom" and t-if="not no_footer";
          priority 99 so views that xpath into the standard footer (portal, website_sale
          copyright) are applied first and nothing breaks.
        - The columns live in the editable div#footer (oe_structure_solo, like Odoo's own
          footers): texts and links can be changed in the website editor.
        - The bottom bar keeps the year up to date.
        - The social + feedback bar sits across the top edge (half over the page, half over the footer).
    -->
    <template id="alihsan_footer" inherit_id="website.layout" name="Al Ihsan Footer" priority="99">
        <xpath expr="//footer[@id='bottom']" position="replace">
            <footer t-if="not no_footer" id="bottom" data-anchor="true" data-name="Footer" class="ih-footer ft" role="contentinfo">
                <div id="footer" class="oe_structure oe_structure_solo" t-ignore="true">
                    <!-- Social + feedback bar, across the top edge of the footer (same markup as the
                         "Social & Feedback CTA" snippet; connect.css / connect.js style and run it) -->
                    <div class="ft-connect">
                        <section class="cn-sec s_connect connect reveal" aria-label="Social links and feedback">
                        <div class="connect-social">
                            <span class="connect-label">Also visit us on:</span>
                            <div class="connect-icons">
                                <a href="#" target="_blank" rel="noopener" aria-label="X (Twitter)"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg></span><em>Twitter</em></a>
                                <a href="#" target="_blank" rel="noopener" aria-label="LinkedIn"><span class="glyph">in</span><em>Linkedin</em></a>
                                <a href="#" target="_blank" rel="noopener" aria-label="Facebook"><span class="glyph">f</span><em>Facebook</em></a>
                                <a href="#" target="_blank" rel="noopener" aria-label="Snapchat"><span><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3.2c2.7 0 4.6 2 4.6 4.8 0 .9.1 1.6.3 2.1.3.6.8.9 1.4 1.1.3.1.4.4.3.7-.2.6-.9.8-1.5 1-.2 0-.3.2-.3.4 0 .3.1.6.2.9.3.5.9.7 1.6.8.3.1.4.4.3.7-.3.7-1.3 1-2.1 1.1-.3 0-.5.2-.6.5-.2.5-.6.9-1.2.9-.9 0-1.5.8-3.5.8s-2.6-.8-3.5-.8c-.6 0-1-.4-1.2-.9-.1-.3-.3-.5-.6-.5-.8-.1-1.8-.4-2.1-1.1-.1-.3.1-.6.3-.7.7-.1 1.3-.3 1.6-.8.1-.3.2-.6.2-.9 0-.2-.1-.4-.3-.4-.6-.2-1.3-.4-1.5-1-.1-.3.1-.6.3-.7.6-.2 1.1-.5 1.4-1.1.2-.5.3-1.2.3-2.1 0-2.8 1.9-4.8 4.6-4.8Z"/></svg></span><em>Snapchat</em></a>
                                <a href="#" target="_blank" rel="noopener" aria-label="Instagram"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.6"/><circle cx="17" cy="7" r=".8" fill="currentColor" stroke="none"/></svg></span><em>Instagram</em></a>
                            </div>
                        </div>
                        <div class="connect-feedback">
                            <span class="connect-label">Give us your feedback:</span>
                            <div class="feedback-scale" role="radiogroup" aria-label="Rate your experience">
                                <button type="button" data-mood="1" aria-label="Very unhappy" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><circle cx="9" cy="10" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="10" r="1" fill="currentColor" stroke="none"/><path d="M8 16c1.3-1.8 2.8-1.8 4-1.8s2.7 0 4 1.8" stroke-linecap="round"/></svg></button>
                                <button type="button" data-mood="2" aria-label="Unhappy" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><circle cx="9" cy="10" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="10" r="1" fill="currentColor" stroke="none"/><path d="M8.5 15.4c1.1-1 2.3-1 3.5-1s2.4 0 3.5 1" stroke-linecap="round"/></svg></button>
                                <button type="button" data-mood="3" aria-label="Neutral" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><circle cx="9" cy="10" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="10" r="1" fill="currentColor" stroke="none"/><path d="M8 14.5h8" stroke-linecap="round"/></svg></button>
                                <button type="button" data-mood="4" aria-label="Happy" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><circle cx="9" cy="10" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="10" r="1" fill="currentColor" stroke="none"/><path d="M8.5 13.6c1.1 1 2.3 1 3.5 1s2.4 0 3.5-1" stroke-linecap="round"/></svg></button>
                                <button type="button" data-mood="5" aria-label="Very happy" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><circle cx="9" cy="10" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="10" r="1" fill="currentColor" stroke="none"/><path d="M8 13c1.3 2 2.8 2 4 2s2.7 0 4-2" stroke-linecap="round"/></svg></button>
                            </div>
                        </div>
                    </section>
                    </div>
                    <div class="ft-in">
                    <div class="ft-grid">
                        <div class="ftf"><a class="ft-logo" href="/" aria-label="Al Ihsan home"><img src="/alihsanwebsite_theme/static/src/img/logo.svg" alt="Al Ihsan Charity Association"/></a><div class="ft-contacts">
                                <a class="ft-c" href="tel:80016"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8.500 7.500c.5 3 3 6.500 6.500 8l1.500-1.500-2-1.500-1 .8c-1-.5-2-1.500-2.500-2.500l.8-1-1.500-2z"/></svg><i></i><span>800 16</span></a>
                                <a class="ft-c" href="mailto:info@alihsan.ae"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M16 12v1.500a2.500 2.500 0 0 0 5 0V12a9 9 0 1 0-3.500 7.100"/></svg><i></i><span>Email Us</span></a>
                                <a class="ft-c" href="https://wa.me/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.500-4.500A9 9 0 1 1 8 19.500z"/><path d="M9 9c0 3 3 6 6 6l1-1.500-2-1-1 .8c-1-.5-1.800-1.300-2.300-2.300l.8-1-1-2z"/></svg><i></i><span>WhatsApp Us</span></a>
                            </div><div class="ft-pay">
                                <span class="ft-mc"><i></i><i></i></span>
                                <span class="ft-ap">Pay</span>
                                <span class="ft-vi">VISA</span>
                            </div></div>
                        <div class="ftf" style="--d:.08s">
                            <h3>Quick Links</h3>
                            <ul>
                                <li><a href="/about-us">About Us</a></li>
                                <li><a href="/general-manager-s-message">Word Of GM</a></li>
                                <li><a href="/chairman">Word Of Chairman</a></li>
                                <li><a href="/contactus">Contact Us</a></li>
                                <li><a href="/faq">FAQs</a></li>
                            </ul>
                        </div>
                        <div class="ftf" style="--d:.16s">
                            <h3>Donations</h3>
                            <ul>
                                <li><a href="/directdonation">Direct Donation</a></li>
                                <li><a href="/sms-donation">Donation By SMS</a></li>
                                <li><a href="/site-representative">Site Representative</a></li>
                                <li><a href="/directdonation">In Kind Contribution</a></li>
                                <li><a href="/bank-donation">Bank Account</a></li>
                            </ul>
                        </div>
                        <div class="ft-promos ftf" style="--d:.24s">
                            <div class="ft-promo">
                                <div class="ft-pt">
                                    <span>Download App</span>
                                    <strong>Al Ihsan Charity</strong>
                                </div>
                                <div class="ft-stores">
                                    <a class="ft-store" href="https://play.google.com" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M4 3.500v17l9-8.500z" fill="#00d6ff"/><path d="M4 3.500 15 9l-2 3z" fill="#00f076"/><path d="m4 20.500 11-5.500-2-3z" fill="#ff3a44"/><path d="M15 9l4 2.300a1 1 0 0 1 0 1.700L15 15l-2-3z" fill="#ffd400"/></svg>Google Play</a>
                                    <a class="ft-store" href="https://www.apple.com/app-store/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="#fff"><path d="M16.500 12.600c0-2.300 1.900-3.400 2-3.500-1.100-1.600-2.800-1.800-3.400-1.800-1.400-.1-2.800.9-3.500.9s-1.800-.9-3-.8C7 7.500 5.600 8.400 4.800 9.800c-1.700 2.900-.4 7.200 1.200 9.600.8 1.200 1.800 2.500 3 2.400 1.200 0 1.700-.8 3.100-.8s1.900.8 3.100.7c1.300 0 2.100-1.200 2.900-2.300.9-1.300 1.300-2.600 1.300-2.700 0 0-2.500-1-2.500-3.800zM14.200 5.600c.6-.8 1.100-1.900.9-3-.9 0-2.100.6-2.700 1.400-.6.700-1.100 1.800-1 2.900 1 .1 2.100-.5 2.800-1.300z"/></svg>App Store</a>
                                </div>
                            </div>
                            <div class="ft-promo">
                                <div class="ft-pt">
                                    <span>Subscribe</span>
                                    <strong class="g">Dhiram Khair</strong>
                                </div>
                                <a class="ft-sms" href="sms:"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h13a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H9l-4 3v-3H3z"/><path d="M21 9v8a2 2 0 0 1-2 2h-1v3l-3-3"/></svg>SMS</a>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
                <div class="ft-bar">
                    <div class="ft-in">
                        <span>© <t t-esc="datetime.date.today().year"/> Al Ihsan. All Rights Reserved.</span>
                        <div class="ft-legal">
                        <a href="https://alihsan.ae/ar" target="_blank" rel="noopener">Terms &amp; Conditions</a>
                        <i></i>
                        <a href="https://alihsan.ae/ar" target="_blank" rel="noopener">Privacy Policy</a>
                    </div>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
