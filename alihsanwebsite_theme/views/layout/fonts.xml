<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Site fonts used by the Al Ihsan snippets: Plus Jakarta Sans (Latin) + IBM Plex Sans Arabic (Arabic) -->
    <template id="alihsan_fonts" inherit_id="website.layout" name="Al Ihsan Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap"/>
        </xpath>
    </template>
</odoo>
